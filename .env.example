# Database (Neon Postgres — required for db-backed routes, migrations, seeding)
# Vercel's Neon integration injects POSTGRES_URL + DATABASE_URL on Preview/Production.
# Locally: `vercel env pull .env.local`, or set your own Postgres connection string.
POSTGRES_URL=postgresql://user:password@host/database?sslmode=require
# DATABASE_URL is accepted as a fallback alias for POSTGRES_URL.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Authentication (dev defaults exist in code; always set JWT_SECRET in production)
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Playwright snapshot target (optional; defaults to http://localhost:3000)
# BASE_URL=http://localhost:3000
